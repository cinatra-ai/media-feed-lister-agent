{
  "name": "@cinatra-ai/media-feed-lister-agent",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "description": "Lists the videos in a YouTube channel or the episodes in a podcast (via RSS/Atom feed discovery). Composes with @cinatra-ai/media-transcript-agent to enable 'transcribe the last N episodes' workflows end-to-end.",
  "type": "module",
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Media Feed Lister Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/media-feeds-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.3"
        },
        "requirement": "required",
        "kind": "connector"
      }
    ],
    "consumes": [
      {
        "primitive": "media_feed_podcast_list",
        "requirement": "required"
      },
      {
        "primitive": "media_feed_youtube_list",
        "requirement": "required"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "media-feed-lister-agent-flow",
    "sourceVersionId": "9c452dda-7131-4e91-bfb3-d9707e1e63d3",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null
  }
}
